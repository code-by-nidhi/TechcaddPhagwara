# Public site origin — used for canonical URLs, sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.techcadd.com

# --- the CMS ----------------------------------------------------------------
# The Express API's /api base. Everything the site reads from the CMS goes
# through it — courses, FAQs, testimonials, gallery, settings, pages, blog,
# events, redirects — and every read falls back to the bundled data in data/*
# when it is unreachable, so leaving this unset runs the site standalone
# exactly as it behaved before the CMS existed.
#
# Must match PORT in cms-techcadd/backend/.env.
CMS_API_URL=http://localhost:4000/api

# --- database ---------------------------------------------------------------
# Enquiries from the Contact form and the Book Demo popup are written straight
# into the CMS's `enquiries` table, so point these at the SAME database the CMS
# backend uses (cms-techcadd/backend/.env). The CMS's migrations create the
# schema; the website only inserts rows.
#
# Leave DB_HOST unset and enquiries fall back to the webhook below, or to the
# server log if that is unset too.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote it if it contains a '#', which would otherwise start a comment and
# silently truncate the password into a confusing access-denied error.
DB_PASSWORD=root123
DB_NAME=techcadd_cms_phg

# Shared with REVALIDATE_SECRET in cms-techcadd/backend/.env. The CMS sends it
# to /api/revalidate after every save so an edit appears immediately instead of
# waiting out the cache window below. Unset, the endpoint refuses every request
# rather than accepting them unauthenticated.
REVALIDATE_SECRET=

# How long a CMS read may be cached, in seconds. Default 3600. This is the
# backstop for a lost revalidate call, not how fast an edit appears.
# CMS_REVALIDATE_SECONDS=3600

# How long the site waits on the CMS before falling back, in ms. Default 5000.
# CMS_TIMEOUT_MS=5000

# Where the CMS admin is served from, comma-separated. The only origins the
# preview frame at /preview/* will exchange messages with. Vite falls back
# through 5173/5174/5175 when a port is taken, which is why all three are here.
NEXT_PUBLIC_CMS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- enquiries --------------------------------------------------------------
# Enquiries are filed in the CMS via CMS_API_URL above. This webhook is an
# optional *second* destination (CRM, Zapier, Make) and is attempted alongside
# it, not instead of it.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_NOTIFY_EMAIL=phagwara@techcadd.com

# Printed in the "we could not submit that, please call us" message. Falls back
# to the number in data/site.ts.
# ENQUIRY_FALLBACK_PHONE=+91 98765 43210

# Where footer newsletter signups are forwarded (Mailchimp, Brevo, Buttondown).
# Leave unset in development: /api/newsletter logs to the server console.
# NOTE: the CMS has no newsletter module, so unlike enquiries there is nowhere
# in it for these to land — this webhook is the only destination there is.
NEWSLETTER_WEBHOOK_URL=
